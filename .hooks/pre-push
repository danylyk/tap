#!/bin/sh

find_claude() {
  if command -v claude >/dev/null 2>&1; then
    command -v claude
    return
  fi

  if [ -x "$HOME/.claude/local/claude" ]; then
    echo "$HOME/.claude/local/claude"
    return
  fi

  ls -d "$HOME"/.vscode*/extensions/anthropic.claude-code-*/resources/native-binary/claude 2>/dev/null \
    | sort -V | tail -n 1
}

CLAUDE=$(find_claude)

if [ -z "$CLAUDE" ] || [ ! -x "$CLAUDE" ]; then
  echo "Could not find the 'claude' binary." >&2
  echo "Install it with: npm install -g @anthropic-ai/claude-code" >&2
  exit 0
fi

nohup "$CLAUDE" --agent pre-push --permission-mode bypassPermissions -p "Process before push" >/dev/null 2>&1 </dev/null &

exit 0
