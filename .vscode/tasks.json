{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start",
      "dependsOn": ["start app", "start api"],
      "dependsOrder": "parallel"
    },
    {
      "label": "Validate",
      "dependsOn": ["validate app", "validate api"],
      "dependsOrder": "sequence"
    },
    {
      "label": "Install",
      "dependsOn": ["ci app", "ci api"],
      "dependsOrder": "sequence"
    },
    {
      "label": "start app",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "./app"
      },
      "presentation": {
        "panel": "new",
        "reveal": "silent"
      }
    },
    {
      "label": "ci app",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "./app"
      },
      "presentation": {
        "panel": "new",
        "reveal": "silent"
      }
    },
    {
      "label": "validate app",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "./app"
      },
      "presentation": {
        "panel": "new"
      }
    },
    {
      "label": "start api",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "./api"
      },
      "presentation": {
        "panel": "new",
        "reveal": "silent"
      }
    },
    {
      "label": "ci api",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "./api"
      },
      "presentation": {
        "panel": "new",
        "reveal": "silent"
      }
    },
    {
      "label": "validate api",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "./api"
      },
      "presentation": {
        "panel": "new"
      }
    }
  ]
}
